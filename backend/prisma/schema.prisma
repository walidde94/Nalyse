generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model Organization {
  id                    String           @id @default(uuid())
  name                  String           @unique
  slug                  String?          @unique
  subscriptionTier      String           @default("free") @map("subscription_tier")
  plan                  String           @default("free")
  stripeCustomerId      String?          @map("stripe_customer_id")
  stripeSubscriptionId  String?          @map("stripe_subscription_id")
  subscriptionStartedAt DateTime?        @map("subscription_started_at")
  currentPeriodEnd      DateTime?        @map("current_period_end")
  cancelAtPeriodEnd     Boolean          @default(false) @map("cancel_at_period_end")
  storageUsed           BigInt           @default(0) @map("storage_used")
  storageLimit          BigInt           @default(104857600) @map("storage_limit")
  userLimit             Int              @default(1) @map("user_limit")
  fileLimit             Int              @default(5) @map("file_limit")
  maxUsers              Int              @default(5) @map("max_users")
  isActive              Boolean          @default(true) @map("is_active")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  dashboards            Dashboard[]
  files                 File[]
  reports               Report[]
  schedules             Schedule[]
  invitations           UserInvitation[]
  users                 User[]
  webhooks              Webhook[]
  workspaces            Workspace[]

  @@map("organizations")
}

model User {
  id                      String                  @id @default(uuid())
  email                   String                  @unique
  passwordHash            String                  @map("password_hash")
  firstName               String?                 @map("first_name")
  lastName                String?                 @map("last_name")
  role                    String                  @default("member")
  plan                    String                  @default("free")
  isActive                Boolean                 @default(true) @map("is_active")
  bio                     String?
  displayName             String?                 @map("display_name")
  avatarUrl               String?                 @map("avatar_url")
  stripeCustomerId        String?                 @map("stripe_customer_id")
  subscriptionStatus      String                  @default("inactive") @map("subscription_status")
  lastLoginAt             DateTime?               @map("last_login_at")
  organizationId          String?                 @map("organization_id")
  emailVerified           Boolean                 @default(false) @map("email_verified")
  emailVerificationToken  String?                 @map("email_verification_token")
  passwordResetToken      String?                 @map("password_reset_token")
  passwordResetExpires    DateTime?               @map("password_reset_expires")
  notificationPreferences Json?                   @default("{}") @map("notification_preferences")
  apiKeys                 Json?                   @default("[]") @map("api_keys")
  createdAt               DateTime                @default(now()) @map("created_at")
  updatedAt               DateTime                @updatedAt @map("updated_at")
  agents                  Agent[]
  analyses                Analysis[]
  analysisConfigs         AnalysisConfiguration[]
  auditLogs               AuditLog[]
  dashboards              Dashboard[]
  files                   File[]
  groups                  Group[]
  notifications           Notification[]
  reports                 Report[]
  schedules               Schedule[]
  invitationsSent         UserInvitation[]        @relation("invitedBy")
  organization            Organization?           @relation(fields: [organizationId], references: [id])
  webhooks                Webhook[]
  workspaceMembers        WorkspaceMember[]
  workspaceMessages       WorkspaceMessage[]

  @@map("users")
}

model File {
  id             String        @id @default(uuid())
  filename       String
  originalName   String?       @map("original_name")
  mimeType       String?       @map("mime_type")
  size           BigInt        @default(0)
  path           String?
  s3Key          String?       @map("s3_key")
  s3Bucket       String?       @map("s3_bucket")
  groupId        String?       @map("group_id")
  metadata       Json?
  checksum       String?
  status         String        @default("ready")
  isFavorite     Boolean       @default(false) @map("is_favorite")
  isDeleted      Boolean       @default(false) @map("is_deleted")
  isProcessed    Boolean       @default(false) @map("is_processed")
  isArchived     Boolean       @default(false) @map("is_archived")
  processedAt    DateTime?     @map("processed_at")
  ownerId        String        @map("owner_id")
  organizationId String?       @map("organization_id")
  workspaceId    String?       @map("workspace_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  analyses       Analysis[]
  group          Group?        @relation(fields: [groupId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])
  owner          User          @relation(fields: [ownerId], references: [id])
  workspace      Workspace?    @relation(fields: [workspaceId], references: [id])
  schedules      Schedule[]

  @@map("files")
}

model Analysis {
  id               String    @id @default(uuid())
  fileId           String    @map("file_id")
  createdById      String    @map("created_by_id")
  status           String    @default("pending")
  results          Json?
  insights         Json?
  statistics       Json?
  errorMessage     String?   @map("error_message")
  processingTimeMs Int?      @map("processing_time_ms")
  completedAt      DateTime? @map("completed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  createdBy        User      @relation(fields: [createdById], references: [id])
  file             File      @relation(fields: [fileId], references: [id])

  @@map("analyses")
}

model Report {
  id             String        @id @default(uuid())
  title          String
  config         Json
  userId         String        @map("user_id")
  organizationId String?       @map("organization_id")
  shareToken     String?       @unique @map("share_token")
  isPublic       Boolean       @default(false) @map("is_public")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  organization   Organization? @relation(fields: [organizationId], references: [id])
  user           User          @relation(fields: [userId], references: [id])

  @@map("reports")
}

model Notification {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  organizationId String?  @map("organization_id")
  title          String
  message        String
  category       String   @default("info")
  priority       String   @default("medium")
  source         String   @default("SYSTEM")
  iconType       String   @default("bell") @map("icon_type")
  color          String   @default("#6366f1")
  actionLabel    String?  @map("action_label")
  actionUrl      String?  @map("action_url")
  prediction     String?
  confidence     Float?
  impactScore    Float?   @map("impact_score")
  metadata       Json     @default("{}")
  read           Boolean  @default(false)
  pinned         Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model UserInvitation {
  id             String       @id @default(uuid())
  email          String
  role           String       @default("member")
  token          String       @unique
  organizationId String       @map("organization_id")
  inviterId      String       @map("inviter_id")
  expiresAt      DateTime     @map("expires_at")
  status         String       @default("pending")
  createdAt      DateTime     @default(now()) @map("created_at")
  inviter        User         @relation("invitedBy", fields: [inviterId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@map("user_invitations")
}

model AnalysisConfiguration {
  id          String   @id @default(uuid())
  name        String
  description String?
  mode        String   @default("standard")
  isPreset    Boolean  @default(false) @map("is_preset")
  isBuiltIn   Boolean  @default(false) @map("is_built_in")
  config      Json
  ownerId     String?  @map("owner_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  owner       User?    @relation(fields: [ownerId], references: [id])

  @@map("analysis_configurations")
}

model Schedule {
  id              String       @id @default(uuid())
  name            String
  cronExpression  String       @map("cron_expression")
  targetFileId    String?      @map("target_file_id")
  config          Json?
  isActive        Boolean      @default(true) @map("is_active")
  organizationId  String       @map("organization_id")
  createdByUserId String       @map("created_by_user_id")
  lastRun         DateTime?    @map("last_run")
  nextRun         DateTime?    @map("next_run")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  createdBy       User         @relation(fields: [createdByUserId], references: [id])
  organization    Organization @relation(fields: [organizationId], references: [id])
  targetFile      File?        @relation(fields: [targetFileId], references: [id])

  @@map("schedules")
}

model Webhook {
  id              String       @id @default(uuid())
  name            String
  url             String
  secret          String?
  events          Json         @default("[\"analysis.completed\"]")
  isActive        Boolean      @default(true) @map("is_active")
  organizationId  String       @map("organization_id")
  createdByUserId String       @map("created_by_user_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  createdBy       User         @relation(fields: [createdByUserId], references: [id])
  organization    Organization @relation(fields: [organizationId], references: [id])

  @@map("webhooks")
}

model Dashboard {
  id             String        @id @default(uuid())
  name           String
  panels         Json          @default("[]")
  gridLayout     Json          @default("[]") @map("grid_layout")
  userId         String        @map("user_id")
  organizationId String?       @map("organization_id")
  workspaceId    String?       @map("workspace_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  organization   Organization? @relation(fields: [organizationId], references: [id])
  user           User          @relation(fields: [userId], references: [id])
  workspace      Workspace?    @relation(fields: [workspaceId], references: [id])

  @@map("dashboards")
}

model Workspace {
  id             String             @id @default(uuid())
  name           String
  organizationId String             @map("organization_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  auditLogs      AuditLog[]
  dashboards     Dashboard[]
  files          File[]
  members        WorkspaceMember[]
  messages       WorkspaceMessage[]
  organization   Organization       @relation(fields: [organizationId], references: [id])

  @@map("workspaces")
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  userId      String    @map("user_id")
  role        String    @default("editor")
  user        User      @relation(fields: [userId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, userId], name: "workspaceId_userId")
  @@map("workspace_members")
}

model WorkspaceMessage {
  id          String             @id @default(uuid())
  workspaceId String             @map("workspace_id")
  authorId    String             @map("author_id")
  content     String
  replyToId   String?            @map("reply_to_id")
  mentions    String[]           @default([])
  reactions   Json?              @default("[]")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  author      User               @relation(fields: [authorId], references: [id])
  replyTo     WorkspaceMessage?  @relation("MessageReplies", fields: [replyToId], references: [id])
  replies     WorkspaceMessage[] @relation("MessageReplies")
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_messages")
}

model AuditLog {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  userId      String    @map("user_id")
  action      String
  entityId    String?   @map("entity_id")
  details     Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@map("audit_logs")
}

model Group {
  id          String   @id @default(uuid())
  name        String
  description String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  files       File[]
  owner       User     @relation(fields: [ownerId], references: [id])

  @@map("groups")
}

model Agent {
  id          String      @id @default(uuid())
  name        String
  role        String
  status      String
  currentGoal String?
  finalReport String?
  userId      String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id])
  tasks       AgentTask[]

  @@map("agent")
}

model AgentTask {
  id          String   @id @default(uuid())
  description String
  status      String   @default("pending")
  result      String?
  agentId     String
  createdAt   DateTime @default(now())
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("agent_task")
}
